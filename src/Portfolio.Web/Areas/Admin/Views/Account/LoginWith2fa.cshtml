@model TwoFactorModel
@{
    ViewData["Title"] = "Authenticator code";
}
<div class="auth-card">
    <h1>Authenticator code</h1>
    <p class="muted">Step 2 of 2. Open your authenticator app and enter the 6-digit code for this site.</p>

    <form method="post" asp-action="LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" class="stack-form" novalidate>
        <partial name="_FormError" />
        <div class="field">
            <label asp-for="Code">Code</label>
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" autofocus class="code-input">
            <span asp-validation-for="Code" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Sign in</button>
    </form>

    <p class="auth-footnote">Lost your phone? <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Use a recovery code</a>.</p>
</div>
