@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-card">
    <h1>Sign in</h1>
    <p class="muted">Step 1 of 2. You'll be asked for a code from your authenticator app next.</p>

    <form method="post" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="stack-form" novalidate>
        <partial name="_FormError" />
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="username" autofocus>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password">
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Continue</button>
    </form>
</div>
