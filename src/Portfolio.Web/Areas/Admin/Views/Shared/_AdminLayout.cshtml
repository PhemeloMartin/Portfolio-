@{
    var signedIn = User.HasClaim("amr", "mfa");
    var path = Context.Request.Path.Value ?? "";
    string Current(string prefix) => (prefix == "/admin" ? path is "/admin" or "/admin/" : path.StartsWith(prefix)) ? "page" : "false";
}
<!doctype html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>@ViewData["Title"] · Portfolio admin</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
</head>
<body class="admin">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container header-inner">
            <a class="wordmark" href="@(signedIn ? "/admin" : "/")">Portfolio admin</a>
            @if (signedIn)
            {
                <nav class="admin-nav" aria-label="Admin">
                    <a href="/admin" aria-current="@Current("/admin")">Dashboard</a>
                    <a href="/admin/messages" aria-current="@Current("/admin/messages")">Messages</a>
                    <a href="/admin/certificates" aria-current="@Current("/admin/certificates")">Certificates</a>
                    <a href="/admin/photo" aria-current="@Current("/admin/photo")">Photo</a>
                    <a href="/" target="_blank" rel="noopener">View site <span aria-hidden="true">↗</span></a>
                    <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout" class="inline-form">
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                </nav>
            }
            <button class="theme-toggle" type="button" aria-label="Switch between day and night theme">
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.2A7.5 7.5 0 0 1 9.8 4.5a7.5 7.5 0 1 0 9.7 9.7z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
            </button>
        </div>
    </header>

    <main id="main" class="admin-main">
        <div class="container">
            @if (TempData["Flash"] is string flash)
            {
                <div class="form-status is-success" role="status">@flash</div>
            }
            @if (TempData["FlashError"] is string flashError)
            {
                <div class="form-status is-error" role="alert">@flashError</div>
            }
            @RenderBody()
        </div>
    </main>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
