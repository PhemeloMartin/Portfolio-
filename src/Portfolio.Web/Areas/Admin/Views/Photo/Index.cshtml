@model PhotoModel
@{
    ViewData["Title"] = "Profile photo";
    var version = Model.UpdatedAtUtc?.Ticks ?? 0;
}
<h1 class="page-title">Profile photo</h1>

<div class="photo-admin">
    <figure class="photo-current">
        <img src="/media/profile-photo?v=@version" width="800" height="1000" alt="Current profile photo">
        <figcaption class="muted">
            @if (Model.HasCustomPhoto)
            {
                <text>Uploaded @Model.UpdatedAtUtc!.Value.ToSast() SAST · @Model.Width × @Model.Height px</text>
            }
            else
            {
                <text>The original graduation photo</text>
            }
        </figcaption>
    </figure>

    <div>
        <form method="post" asp-action="Upload" enctype="multipart/form-data" class="stack-form" novalidate>
            <div class="field">
                <label for="photo">Upload a new photo</label>
                <input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required>
                <p class="field-hint">JPEG, PNG or WebP, up to 8 MB. A portrait (taller than wide) photo works best.</p>
                <p class="field-hint">Before saving, the photo is resized and re-encoded, which removes hidden details such as GPS location and camera information.</p>
            </div>
            <button type="submit" class="btn btn-primary">Upload photo</button>
        </form>

        @if (Model.HasCustomPhoto)
        {
            <form method="post" asp-action="Reset" class="inline-form reset-form" data-confirm="Go back to the original graduation photo?">
                <button type="submit" class="btn btn-secondary">Use the original photo</button>
            </form>
        }
    </div>
</div>
