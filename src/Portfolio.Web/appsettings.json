{
  // Secrets (database connection, admin password) never go in this file.
  // Locally: dotnet user-secrets. In production: environment variables on the host.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Portfolio": ""
  },
  "Site": {
    // The public address, used for canonical links and the sitemap. Set it once the domain is live.
    "BaseUrl": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Privacy": {
    "MessageRetentionDays": 180
  }
}
