@inject PortfolioContent Site
@{
    ViewData["Title"] = "Page not found";
}

<section class="page error-page">
    <div class="container prose">
        <p class="meta">Error 404</p>
        <h1>That page doesn't exist</h1>
        <p class="lede">The link may be old or mistyped. These might be what you were looking for:</p>
        <ul class="bullets">
            <li><a href="/#work">Selected work</a></li>
            @foreach (var p in Site.Projects.Where(p => p.CaseStudy.Count > 0))
            {
                <li><a href="/projects/@p.Slug">@p.Title</a></li>
            }
            <li><a href="/#certifications">Certifications</a></li>
            <li><a href="/#contact">Contact</a></li>
        </ul>
        <p class="error-actions"><a class="btn btn-primary" href="/">Go to the home page</a></p>
    </div>
</section>
