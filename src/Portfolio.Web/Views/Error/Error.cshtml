@model ErrorViewModel
@inject PortfolioContent Site
@{
    var (title, message) = Model.StatusCode switch
    {
        400 => ("That request couldn't be processed",
                "If you were sending a message, the page may have been open for a long time. Go back, refresh the page and try again."),
        403 => ("You don't have access to that page", "If you think this is a mistake, head back to the home page."),
        503 => ("This part of the site is temporarily unavailable", "Please try again in a few minutes."),
        _ => ("Something went wrong on my side", "The problem has been logged. Please try again in a moment. If it keeps happening, email me and mention the reference below."),
    };
    ViewData["Title"] = title;
}

<section class="page error-page">
    <div class="container prose">
        <p class="meta">Error @Model.StatusCode</p>
        <h1>@title</h1>
        <p class="lede">@message</p>
        @if (!string.IsNullOrEmpty(Model.Reference))
        {
            <p class="reference">Reference: <code>@Model.Reference</code></p>
        }
        <p class="error-actions">
            <a class="btn btn-primary" href="/">Go to the home page</a>
            <a class="btn btn-secondary" href="mailto:@Site.Contact.Email">Email me</a>
        </p>
    </div>
</section>
